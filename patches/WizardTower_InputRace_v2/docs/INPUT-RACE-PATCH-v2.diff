+
+// Regression: Wizard's Tower crash (0xC0000374 double free / 0xC0000005 in
+// RefreshDevices -> std::vector<DeviceInfo>::clear). The game calls
+// XamInputGetState / XamInputGetCapabilities from GameThread and from the
+// "3D Engine" thread at the same time. Without InputSystem::state_mutex_ this
+// test corrupts the heap (crash or failure); with the lock it must pass.
+TEST_CASE("Concurrent guest input calls do not corrupt device bookkeeping", "[input][threading]") {
+  FakeDriver* driver = nullptr;
+  auto system = SharedSystem(&driver);
+  driver->AddNamed(1, false, "Wireless Controller (concurrency test pad)",
+                   "030000004c050000e60c000000000000-long-guid");
+  driver->AddNamed(2, true, "Keyboard & Mouse (synthetic test device)",
+                   "synthetic-keyboard-mouse-device-guid-0001");
+  driver->SetButtons(1, X_INPUT_GAMEPAD_A);
+
+  constexpr int kIterations = 20000;
+  std::atomic<bool> go{false};
+  std::atomic<uint32_t> failures{0};
+  auto wait_go = [&]() {
+    while (!go.load(std::memory_order_acquire)) {
+      std::this_thread::yield();
+    }
+  };
+
+  std::thread game_thread([&]() {
+    wait_go();
+    for (int i = 0; i < kIterations; ++i) {
+      X_INPUT_STATE state = {};
+      if (system->GetState(0, &state) != X_ERROR_SUCCESS ||
+          static_cast<uint16_t>(state.gamepad.buttons) != X_INPUT_GAMEPAD_A) {
+        ++failures;
+      }
+    }
+  });
+  std::thread engine_thread([&]() {
+    wait_go();
+    for (int i = 0; i < kIterations; ++i) {
+      X_INPUT_STATE state = {};
+      if (system->GetState(0, &state) != X_ERROR_SUCCESS) {
+        ++failures;
+      }
+      X_INPUT_CAPABILITIES caps = {};
+      if (system->GetCapabilities(0, 0, &caps) != X_ERROR_SUCCESS) {
+        ++failures;
+      }
+    }
+  });
+  std::thread vibration_thread([&]() {
+    wait_go();
+    for (int i = 0; i < kIterations; ++i) {
+      X_INPUT_VIBRATION vibration = {};
+      if (system->SetState(0, &vibration) != X_ERROR_SUCCESS) {
+        ++failures;
+      }
+    }
+  });
+  std::thread keystroke_thread([&]() {
+    wait_go();
+    for (int i = 0; i < kIterations; ++i) {
+      X_INPUT_KEYSTROKE keystroke = {};
+      X_RESULT r = system->GetKeystroke(0, 0, &keystroke);
+      if (r != X_ERROR_EMPTY && r != X_ERROR_SUCCESS) {
+        ++failures;
+      }
+    }
+  });
+
+  go.store(true, std::memory_order_release);
+  game_thread.join();
+  engine_thread.join();
+  vibration_thread.join();
+  keystroke_thread.join();
+  REQUIRE(failures.load() == 0);
+
+  // Bookkeeping is still consistent after the storm.
+  X_INPUT_STATE state = {};
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<uint16_t>(state.gamepad.buttons) == X_INPUT_GAMEPAD_A);
+}
