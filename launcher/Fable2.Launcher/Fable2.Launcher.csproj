<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Fable2Launcher</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyTitle>Fable II Recompiled — Launcher 2.0.0</AssemblyTitle>
    <Product>Fable II Recompiled Launcher</Product>
    <Description>Version 2.0.0: redesigned home screen and five-section settings. Keeps hero/dog texture modes, Xbox/PlayStation/keyboard prompts, game speed, patches, HOTFUNC and EN/RU. Modifications by deadtools (https://github.com/deadtools).</Description>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <RootNamespace>Fable2Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\constants\GameVersions.cs" Link="Constants\GameVersions.cs" />
    <!-- Reusable Xbox 360 disc reader/extractor (GDFX + ISO 9660 + STFS), shared
         with tools/x360extract. Consumed as a project reference; produces X360ExtractCore.dll. -->
    <ProjectReference Include="..\..\tools\x360extract\lib\X360Extract.Core.csproj" />
    <Resource Include="..\..\assets\app-icon.png" Link="Assets\app-icon.png" />
    <Resource Include="Resources\frames_elements_original.png" />
    <Resource Include="Resources\MouseButtons\LMB.png" />
    <Resource Include="Resources\MouseButtons\MMB.png" />
    <Resource Include="Resources\MouseButtons\RMB.png" />
    <Resource Include="Resources\V2\home-background.jpg" />
    <Resource Include="Resources\V2\settings-background.jpg" />
    <Resource Include="Resources\V2\gear.png" />
    <Resource Include="Resources\V2\achievements.json" />
  </ItemGroup>
</Project>
