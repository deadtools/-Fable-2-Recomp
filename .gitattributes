# Unified-diff context lines representing blank source lines contain one space.
thirdparty/rexglue-sdk-runtime-fixes.patch text eol=lf whitespace=-blank-at-eol
thirdparty/rexglue-sdk-debug-exports.patch text eol=lf whitespace=-blank-at-eol

# Windows batch scripts must use CRLF on checkout (cmd.exe misparses LF labels/gotos).
*.cmd text eol=crlf
*.bat text eol=crlf
